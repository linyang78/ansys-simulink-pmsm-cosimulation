# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
# dist/ 下是交付包（自包含工具包），要纳入版本库；上面排除的是构建产物
!dist/
!dist/**
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===== 会话临时区 =====
.thincoder/tmp/
.thincoder/memory/

# ===== 资料库与开发过程记录（不上传）=====
# help/ 含第三方仓库克隆、Ansys 官方帮助快照、旧项目归档
help/

# ===== 需求与设计文档（开发过程，不上传）=====
docs/

# ===== 项目状态文件（本地开发用）=====
PROJECT-MANIFEST.json

# ===== 运行产物与手工调试模型（不上传）=====
results/
models/manual/
models/aedt/E11/
models/aedt/E11_ece.aedt
models/motorcad/*.txt

# ===== maxwell_ece 开发过程记录（不上传）=====
src/maxwell_ece/research/
src/maxwell_ece/outputs/
src/maxwell_ece/work/
src/maxwell_ece/config/archive/
src/maxwell_ece/config/e11-healthy-draft.json
src/maxwell_ece/config/inspection.json
src/maxwell_ece/docs/


				NumParts=1
				ModSinceLib=true
				Terminal('A0', 'A0', 'A', false, 0, 0, '', 'Electrical', '0')
				Terminal('X0', 'X0', 'A', false, 1, 0, '', 'Electrical', '0')
				Terminal('B0', 'B0', 'A', false, 2, 0, '', 'Electrical', '0')
				Terminal('Y0', 'Y0', 'A', false, 3, 0, '', 'Electrical', '0')
				Terminal('C0', 'C0', 'A', false, 4, 0, '', 'Electrical', '0')
				Terminal('Z0', 'Z0', 'A', false, 5, 0, '', 'Electrical', '0')
				Terminal('ROT1', 'ROT1', 'A', false, 6, 0, '', 'Rotational_V', '0')
				Terminal('ROT2', 'ROT2', 'A', false, 7, 0, '', 'Rotational_V', '0')
				$begin 'SimModelDefs'
					MaxwellECEData(0, '', '')
				$end 'SimModelDefs'
				CompExtID=2
				$begin 'Parameters'
					ButtonProp('SimplorerNetlist', 'HD', '', 'MODEL MaxwellECEData ?InstanceName(@InstanceName):(@(Refbase)@(ID)) A0:= %0, X0:= %1, B0:= %2, Y0:= %3, C0:= %4, Z0:= %5, ROT1:= %6, ROT2:= %7  (  ra0:=@ra0, la0:=@la0, IniIa0:=@IniIa0, IniIb0:=@IniIb0, IniIc0:=@IniIc0, IniPos:=@IniPos) SRC: DB(Lib:=@ModelLibraryName) ;', 'MODEL MaxwellECEData ?InstanceName(@InstanceName):(@(Refbase)@(ID)) A0:= %0, X0:= %1, B0:= %2, Y0:= %3, C0:= %4, Z0:= %5, ROT1:= %6, ROT2:= %7  (  ra0:=@ra0, la0:=@la0, IniIa0:=@IniIa0, IniIb0:=@IniIb0, IniIc0:=@IniIc0, IniPos:=@IniPos) SRC: DB(Lib:=@ModelLibraryName) ;', 1, ButtonPropClientData())
					TextProp('InstanceName', 'D', '', CB='InstanceName', '')
					ButtonProp('SimplorerGlobalRef', 'HD', '', '', '', 1, ButtonPropClientData())
					ButtonProp('Data', 'D', '', 'MaxwellECEData', '', 0, ButtonPropClientData())
					MenuVariableProp('SimulatorModel', 'D', 'Chosen Simulation Model', '"MaxwellECEData"', 'MaxwellECEData', 0, Attrs(Info('', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '', false, false))
				$end 'Parameters'
				$begin 'Quantities'
					QuantityProp('ra0', 'D', '', '0.001', '', AdditionalPropInfo='', Attrs(Info('ra0', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '0.001', false, false))
					QuantityProp('la0', 'D', '', '1e-06', '', AdditionalPropInfo='', Attrs(Info('la0', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '1e-06', false, false))
					QuantityProp('IniIa0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('IniIa0', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('IniIb0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('IniIb0', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('IniIc0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('IniIc0', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('Fluxa0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('Fluxa0', 0, '', IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('Fluxb0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('Fluxb0', 0, '', IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('Fluxc0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('Fluxc0', 0, '', IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('Fluxd0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('Fluxd0', 0, '', IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('Fluxq0', 'D', '', '0', '', AdditionalPropInfo='', Attrs(Info('Fluxq0', 0, '', IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0', false, false))
					QuantityProp('IniPos', 'D', '', '30deg', 'deg', AdditionalPropInfo='', Attrs(Info('IniPos', 0, 'deg', PhyTypes('ANGLE', 'real'), IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '30deg', false, false))
					QuantityProp('Pos', 'D', '', '0deg', 'deg', AdditionalPropInfo='', Attrs(Info('Pos', 0, 'deg', PhyTypes('ANGLE', 'real'), IsUnconstrained=false), 'Out', 'BeforeAnalogSolver', false, false, false, '0deg', false, false))
				$end 'Quantities'
				$begin 'CompData'
					ComponentDataType='MaxwellECEData'
					name='MaxwellECEData'
					filename='$PROJECTDIR\\RotorySimulink.aedt'
					numberofports=8
					Is3D=false
					IsWBLink=false
					WBSystemId=''
					CouplingDesignName='ECE (Transient)'
					CouplingSolutionName=''
					CouplingMatrixName=''
					SaveProject=false
					CloseProject=false
					StaticLink=false
					CouplingType='SmlMaxwell2DECELink'
					VariationKey=''
					NewToOldMap()
					OldToNewMap()
					ModelText='MODELDEF ECER_Model1\
{\
PORT electrical: A0;\
PORT electrical: X0;\
PORT electrical: B0;\
PORT electrical: Y0;\
PORT electrical: C0;\
PORT electrical: Z0;\
PORT ROTATIONAL_V: ROT1;\
PORT ROTATIONAL_V: ROT2;\
PORT REAL IN: ra0 = 0.001;\
PORT REAL IN: la0 = 1e-06;\
PORT REAL IN: IniIa0 = 0;\
PORT REAL IN: IniIb0 = 0;\
PORT REAL IN: IniIc0 = 0;\
PORT REAL OUT: Fluxa0 = AM_Fluxa0.I;\
PORT REAL OUT: Fluxb0 = AM_Fluxb0.I;\
PORT REAL OUT: Fluxc0 = AM_Fluxc0.I;\
PORT REAL OUT: Fluxd0 = AMFd.I;\
PORT REAL OUT: Fluxq0 = AMFq.I;\
PORT REAL IN ANGLE[deg]: IniPos = 30;\
PORT REAL OUT ANGLE[deg]: Pos = VM_Mdeg.V;\
\
INTERN  R        Ra0  N1:=A0, N2:=N_1  ( R:=ra0 ); \
INTERN  L        La0  N1:=N_1, N2:=N_2  ( L:=la0, I0:=IniIa0 ); \
INTERN  AM       AMa0  N1:=N_2, N2:=N_3  ; \
INTERN  EV       Ema0  N1:=N_3, N2:=X0  ( QUANT:=VMa0.V, FACT:=-1 ); \
INTERN  L        Lma0  N1:=N_4, N2:=GND  ( L:=1 ); \
INTERN  VM       VMa0  N1:=N_4, N2:=GND  ; \
INTERN  AM       AM_Fluxa0  N1:=N_5, N2:=N_4  ; \
INTERN  II       Fluxad  N1:=GND, N2:=N_5  ( QUANT:=AMFd.I, FACT:=cos(VM_Erad.V) ); \
INTERN  II       Fluxaq  N1:=GND, N2:=N_5  ( QUANT:=AMFq.I, FACT:=sin(VM_Erad.V) ); \
INTERN  II       Fluxao  N1:=GND, N2:=N_5  ( QUANT:=AMFo.I, FACT:=1 ); \
INTERN  II       Fluxa0  N1:=GND, N2:=N_5  ( QUANT:=AMo.I, FACT:=0.00265068 ); \
\
INTERN  R        Rb0  N1:=B0, N2:=N_6  ( R:=ra0 ); \
INTERN  L        Lb0  N1:=N_6, N2:=N_7  ( L:=la0, I0:=IniIb0 ); \
INTERN  AM       AMb0  N1:=N_7, N2:=N_8  ; \
INTERN  EV       Emb0  N1:=N_8, N2:=Y0  ( QUANT:=VMb0.V, FACT:=-1 ); \
INTERN  L        Lmb0  N1:=N_9, N2:=GND  ( L:=1 ); \
INTERN  VM       VMb0  N1:=N_9, N2:=GND  ; \
INTERN  AM       AM_Fluxb0  N1:=N_10, N2:=N_9  ; \
INTERN  II       Fluxbd  N1:=GND, N2:=N_10  ( QUANT:=AMFd.I, FACT:=cos(VM_Erad.V-2*PI/3) ); \
INTERN  II       Fluxbq  N1:=GND, N2:=N_10  ( QUANT:=AMFq.I, FACT:=sin(VM_Erad.V-2*PI/3) ); \
INTERN  II       Fluxbo  N1:=GND, N2:=N_10  ( QUANT:=AMFo.I, FACT:=1 ); \
INTERN  II       Fluxb0  N1:=GND, N2:=N_10  ( QUANT:=AMo.I, FACT:=0.00265068 ); \
\
INTERN  R        Rc0  N1:=C0, N2:=N_11  ( R:=ra0 ); \
INTERN  L        Lc0  N1:=N_11, N2:=N_12  ( L:=la0, I0:=IniIc0 ); \
INTERN  AM       AMc0  N1:=N_12, N2:=N_13  ; \
INTERN  EV       Emc0  N1:=N_13, N2:=Z0  ( QUANT:=VMc0.V, FACT:=-1 ); \
INTERN  L        Lmc0  N1:=N_14, N2:=GND  ( L:=1 ); \
INTERN  VM       VMc0  N1:=N_14, N2:=GND  ; \
INTERN  AM       AM_Fluxc0  N1:=N_15, N2:=N_14  ; \
INTERN  II       Fluxcd  N1:=GND, N2:=N_15  ( QUANT:=AMFd.I, FACT:=cos(VM_Erad.V-4*PI/3) ); \
INTERN  II       Fluxcq  N1:=GND, N2:=N_15  ( QUANT:=AMFq.I, FACT:=sin(VM_Erad.V-4*PI/3) ); \
INTERN  II       Fluxco  N1:=GND, N2:=N_15  ( QUANT:=AMFo.I, FACT:=1 ); \
INTERN  II       Fluxc0  N1:=GND, N2:=N_15  ( QUANT:=AMo.I, FACT:=0.00265068 ); \
\
INTERN  AM       AMFd  N1:=N_16, N2:=GND  ; \
INTERN  AM       AMFq  N1:=N_17, N2:=GND  ; \
INTERN  AM       AMFo  N1:=N_18, N2:=GND  ; \
\
INTERN  II       Id0  N1:=GND, N2:=N_19  ( QUANT:=AMa0.I, FACT:=2/3*cos(VM_Erad.V) ); \
INTERN  II       Id1  N1:=GND, N2:=N_19  ( QUANT:=AMb0.I, FACT:=2/3*cos(VM_Erad.V-2*PI/3) ); \

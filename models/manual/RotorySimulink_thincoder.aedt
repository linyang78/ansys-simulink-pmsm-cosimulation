					MenuVariableProp('SimulatorModel', 'D', 'Chosen Simulation Model', '"Simplorer Elements\\Basic Elements\\Basic Elements:FM_ROTB"', 'Simplorer Elements\\Basic Elements\\Basic Elements:FM_ROTB', 0, Attrs(Info('', 0, '', IsUnconstrained=false), 'In', 'BeforeAnalogSolver', false, false, false, '', false, false))
